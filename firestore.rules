rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public reaction counters. Anyone may read the tallies and bump a count.
    // Everything else is locked down.
    match /reactions/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
